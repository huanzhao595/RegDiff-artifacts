    "    apkname = apk_dir.name\n",
    "    out_path = OUT_DIR / f\"{apkname}.json\"\n",
    "    if out_path.exists():\n",
    "        continue\n",
    "\n",
    "    txt_files = sorted(apk_dir.glob(\"*.txt\"))\n",
    "    if not txt_files:\n",
    "        continue\n",
    "\n",
    "    # 你说“会有一个 txt”，这里取第一个；如果你想合并多个 txt，可在此扩展\n",
    "    txt = txt_files[0].read_text(encoding=\"utf-8\", errors=\"ignore\")\n",
