    "    likely = [b for b in coarse.get(\"likely\", []) if b in VALID_BUCKETS]\n",
    "    print(f\"Coarse classification for {apkname}: likely buckets: {likely}, reason: {coarse.get('reason', '')}\")\n",
    "\n",
    "    results.append({\n",
